{
	"name": "ohttp-ts",
	"version": "0.6.2",
	"description": "Oblivious HTTP (RFC 9458) implementation with chunked extension support",
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"docs",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"examples": "node examples/index.ts",
		"test": "vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:workers": "vitest run --config vitest.workers.config.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --reporter=verbose",
		"bench:browser": "vitest bench --config vitest.browser.config.ts --reporter=verbose",
		"bench:workers": "vitest bench --config vitest.workers.bench.config.ts --run bench/workerd.bench.ts bench/concurrency.bench.ts bench/streaming.bench.ts --reporter=verbose",
		"bench:workers:backpressure": "vitest run --config vitest.workers.bench.config.ts bench/workerd-backpressure.test.ts --reporter=verbose",
		"bench:concurrency": "vitest bench --run bench/concurrency.bench.ts --reporter=verbose",
		"bench:overlap": "node bench/overlap.ts",
		"bench:alloc": "node --expose-gc bench/alloc.ts",
		"bench:backpressure": "node --expose-gc bench/backpressure.ts",
		"bench:profile": "node bench/profile.ts",
		"bench:trace": "node bench/trace.ts",
		"check:package": "publint && attw --pack --profile esm-only",
		"check:treeshake": "node tools/check-treeshake.ts",
		"size": "node tools/size.ts",
		"metrics": "node tools/metrics.ts",
		"lint": "biome check bench examples src test tools",
		"format": "biome format --write bench examples src test tools",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
	},
	"keywords": [
		"ohttp",
		"oblivious-http",
		"hpke",
		"privacy",
		"encryption",
		"rfc9458"
	],
	"author": "Thibault Meunier",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thibmeu/ohttp-ts.git"
	},
	"bugs": {
		"url": "https://github.com/thibmeu/ohttp-ts/issues"
	},
	"homepage": "https://github.com/thibmeu/ohttp-ts#readme",
	"dependencies": {
		"bhttp-ts": "0.6.1",
		"quicvarint": "0.2.1"
	},
	"peerDependencies": {
		"hpke": "^1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.6.2",
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@fast-check/vitest": "0.5.0",
		"@hpke/chacha20poly1305": "1.8.0",
		"@panva/hpke-noble": "1.1.7",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.5",
		"@vitest/browser": "5.0.5",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "0.28.2",
		"esbuild-visualizer": "0.7.0",
		"fast-check": "4.10.2",
		"hpke": "1.1.7",
		"publint": "0.3.25",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"overrides": {
		"tsdown": {
			"typescript": "7.0.2"
		},
		"@arethetypeswrong/core": {
			"typescript": "5.9.3"
		}
	}
}
