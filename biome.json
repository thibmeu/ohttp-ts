{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noNonNullAssertion": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["bench/**"],
			"linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	}
}
